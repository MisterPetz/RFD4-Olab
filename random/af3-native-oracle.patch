+def _required_env_vars() -> tuple[str, ...]:
+    """Env vars the oracle cannot run without.
+
+    ``AF3_IMAGE`` is only needed for the apptainer route; a native install
+    selected by ``AF3_NATIVE_PYTHON`` supplies the interpreter instead.
+    """
+    if os.environ.get("AF3_NATIVE_PYTHON", "").strip():
+        return ("AF3_NATIVE_PYTHON", "AF3_JAX_CACHE_DIR", "AF3_MODEL_DIR")
+    return ("AF3_IMAGE", "AF3_JAX_CACHE_DIR", "AF3_MODEL_DIR")
+
+
+_REQUIRED_ENV_VARS = _required_env_vars()
 
 
